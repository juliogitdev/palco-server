# Porta da API que o Roblox vai consultar
PORT=3000

# Usuario da sua live no TikTok (sem @)
TIKTOK_USERNAME=

# Token secreto que o Roblox envia no cabecalho Authorization.
# Gere um valor aleatorio e longo. NUNCA comite o .env real.
API_TOKEN=


TIKTOOL_API_KEY=

# (Opcional) Chave da Euler Stream para aumentar os limites de conexao
EULER_API_KEY=

# Quantas posicoes o placar mostra
TOP_N=3

# Quantos eventos a fila guarda na memoria
TAMANHO_FILA=500
